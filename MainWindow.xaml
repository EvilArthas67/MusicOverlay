<Window x:Class="MusicOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Overlay"
        Width="420"
        Height="135"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- КРУГЛЫЕ КНОПКИ -->

        <Style x:Key="CircleButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#555555"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">

                            <Ellipse Fill="{TemplateBinding Background}"/>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ОСНОВНОЙ ФОН -->

    <Border CornerRadius="18"
            Background="#E91E1E1E"
            Padding="15"
            Margin="5">

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="70"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="130"/>

            </Grid.ColumnDefinitions>


            <!-- ОБЛОЖКА -->

            <Border Grid.Column="0"
                    Width="65"
                    Height="65"
                    CornerRadius="10"
                    Background="#333333">

                <Image x:Name="AlbumArt"
                       Width="65"
                       Height="65"
                       Stretch="UniformToFill"/>

            </Border>


            <!-- ИНФОРМАЦИЯ -->

            <Grid Grid.Column="1"
                  Margin="12,0,5,0"
                  VerticalAlignment="Center">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- НАЗВАНИЕ -->

                <TextBlock x:Name="SongTitle"
                           Grid.Row="0"
                           Text="Название песни"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>


                <!-- ИСПОЛНИТЕЛЬ -->

                <TextBlock x:Name="ArtistName"
                           Grid.Row="1"
                           Text="Исполнитель"
                           Foreground="#AAAAAA"
                           FontSize="13"
                           Margin="0,2,0,4"
                           TextTrimming="CharacterEllipsis"/>


                <!-- ПОЛЗУНОК -->

                <Grid x:Name="ProgressArea"
                      Grid.Row="2"
                      Height="16"
                      MouseEnter="ProgressArea_MouseEnter"
                      MouseLeave="ProgressArea_MouseLeave">


                    <!-- ФОН ПОЛОСЫ -->

                    <Border Height="3"
                            VerticalAlignment="Center"
                            Background="#444444"
                            CornerRadius="2"/>


                    <!-- ПРОЙДЕННАЯ ЧАСТЬ -->

                    <Border x:Name="ProgressFill"
                            Height="3"
                            Width="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="White"
                            CornerRadius="2"/>


                    <!-- КРУГ -->

                    <Ellipse x:Name="ProgressThumb"
                             Width="8"
                             Height="8"
                             Fill="White"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Margin="0"
                             Visibility="Collapsed"/>


                    <!-- ПРОЗРАЧНЫЙ SLIDER -->

                    <Slider x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            Opacity="0"
                            Background="Transparent"
                            BorderThickness="0"
                            PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ProgressSlider_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"/>

                </Grid>


                <!-- ВРЕМЯ -->

                <Grid Grid.Row="2"
                      Margin="0,13,0,0">

                    <TextBlock x:Name="CurrentTimeText"
                               Text="0:00"
                               Foreground="#888888"
                               FontSize="9"
                               HorizontalAlignment="Left"/>

                    <TextBlock x:Name="DurationText"
                               Text="0:00"
                               Foreground="#888888"
                               FontSize="9"
                               HorizontalAlignment="Right"/>

                </Grid>

            </Grid>


            <!-- КНОПКИ -->

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">


                <!-- НАЗАД -->

                <Button x:Name="PreviousButton"
                        Width="35"
                        Height="35"
                        Margin="2"
                        Style="{StaticResource CircleButton}"
                        Click="PreviousButton_Click">

                    <Canvas Width="20"
                            Height="20">

                        <Path Fill="Black"
                              Data="M 14,3 L 3,10 L 14,17 Z"/>

                        <Rectangle Width="2"
                                   Height="14"
                                   Fill="Black"
                                   Canvas.Left="16"
                                   Canvas.Top="3"/>

                    </Canvas>

                </Button>


                <!-- PLAY / PAUSE -->

                <Button x:Name="PlayPauseButton"
                        Width="40"
                        Height="40"
                        Margin="2"
                        Style="{StaticResource CircleButton}"
                        Click="PlayPauseButton_Click">

                    <Viewbox Width="18"
                             Height="20">

                        <Path x:Name="PlayIcon"
                              Fill="Black"/>

                    </Viewbox>

                </Button>


                <!-- ВПЕРЁД -->

                <Button x:Name="NextButton"
                        Width="35"
                        Height="35"
                        Margin="2"
                        Style="{StaticResource CircleButton}"
                        Click="NextButton_Click">

                    <Canvas Width="20"
                            Height="20">

                        <Rectangle Width="2"
                                   Height="14"
                                   Fill="Black"
                                   Canvas.Left="2"
                                   Canvas.Top="3"/>

                        <Path Fill="Black"
                              Data="M 6,3 L 17,10 L 6,17 Z"/>

                    </Canvas>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</Window>
